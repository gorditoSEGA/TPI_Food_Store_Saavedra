# Copiar como .env y ajustar. El archivo .env no se entrega.
# PostgreSQL (la base debe existir previamente):
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db
# Alternativa para desarrollo local sin PostgreSQL:
# DATABASE_URL=sqlite:///./foodstore.db

# Clave para firmar los JWT (mínimo 32 caracteres). Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
